# Install file: protocol dependencies (e.g. @openzeppelin/hardhat-tron at
# file:../hardhat-tron) as COPIED packages rather than symlinks.
#
# Why this matters: the hardhat-tron plugin's runtime installs TVM-aware
# chai matchers (changeTokenBalance/changeEtherBalance) onto the chai
# singleton via `require('chai')`. With the default symlink install, Node
# resolves that require against the SIBLING checkout's realpath — i.e. its
# own node_modules/chai — a different instance than the one the test suite
# uses. The TVM matchers then register on the wrong chai, the tests see
# upstream's matchers, and every changeTokenBalance assertion crashes with
# `eth_getBlockByHash` -> java.lang.NullPointerException on TRE.
#
# Copying the package (no nested node_modules) makes `require('chai')`
# resolve up to THIS project's single chai — matching how the spike vendors
# the plugin. Keep this enabled.
install-links=true
